	(text "PMOD Type 2A (expanded SPI): RT1010 LPSPI1 is master by default;\nLPSPI PINCFG can swap SDI/SDO if the FPGA is master. INT on 7, RST on 8."
		(exclude_from_sim no)
		(at 218.44 248.92 0)
