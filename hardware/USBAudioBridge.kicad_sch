			)
			(justify left)
		)
		(uuid "e649c8af-50f0-5c15-bba9-a85f4c603ffb")
	)
	(text "NXP i.MX RT1010 USB 2.0 HS asynchronous audio device bridging to an Arty A7 FPGA board over two PMOD ports (JB: I2S, JC: SPI + GPIO)."
